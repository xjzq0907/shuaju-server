# 复制为 .env 后按自己的环境修改：cp .env.example .env

# ===== 必填：路径（宿主机绝对路径） =====
# 索引 CSV + import_state.json 所在目录（与 quark-links CLI 工具共用）
QUARK_LINKS_DIR=/path/to/quark-links
# 本地短剧库根目录
LIB_ROOT=/path/to/短剧库
# SQLite 数据目录
DATA_DIR=/path/to/duanju-data
# quark-auto-save 的 quark_config.json（只读）
QUARK_CFG=/path/to/quark_config.json

# ===== 可选 =====
# 访问令牌：非空时所有 /api/* 需带 X-Auth-Token 头或 ?token= 参数（App 与网页端在设置里填同一个值）；留空 = 不鉴权
AUTH_TOKEN=
# 服务端口（network_mode: host 下直接监听宿主端口）
PORT=15006
# quark-auto-save WebUI 地址
QUARK_AUTOSAVE_URL=http://127.0.0.1:15005
# aria2 JSON-RPC 地址
ARIA2_RPC=http://127.0.0.1:16800/jsonrpc
# 单批转存部数
BATCH_SIZE=20
